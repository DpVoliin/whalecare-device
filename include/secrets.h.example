// 复制成 include/secrets.h 再填（secrets.h 已在 .gitignore 里，**绝不入库**）
#pragma once

// ① 家里 Wi-Fi（ESP32-S3 只支持 2.4GHz ✗ 5GHz 连不上）
#define WIFI_SSID   "你的WiFi名"
#define WIFI_PASS   "你的WiFi密码"

// ② 中枢地址（公网那台的 11443 + 域名或 IP）
#define WHALE_HOST  "hub.example.com"
#define WHALE_PORT  11443

// ③ 设备自己的 token（单片机专用，不是主 token）
//    在服务器上取：sudo -n python3 -c "import json;print(json.load(open('/root/hub/hub.json'))['mcu']['token'])"
#define WHALE_TOKEN "把上一条命令打印的 token 贴这里"
#define WHALE_DEVICE "desk-whale"     // 中枢里显示的名字

// ④ 中枢那张自签证书（PEM 全文）—— 用来做证书固定，比 setInsecure 强得多
//    在服务器上取：sudo -n cat /root/hub/tls/hub.crt
static const char WHALE_CA_CERT[] = R"CERT(
-----BEGIN CERTIFICATE-----
把 /root/hub/tls/hub.crt 的全部内容贴进来（含 BEGIN/END 两行）
-----END CERTIFICATE-----
)CERT";
